#!/usr/bin/env python3
"""Claude Brain command line. Usage: brain <command> [options]. Standard library only."""
import argparse
import importlib
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))


def _bytecode_cache() -> None:
    """Keep compiled modules under the user's cache folder, not in the tree.

    A cloud session starts from a fresh clone: with no bytecode every call
    compiled every module it loaded (about 120 ms). The cache sits outside the
    checkout so the tree stays as git left it, also when it is read-only.
    The user's own choice (PYTHONPYCACHEPREFIX, PYTHONDONTWRITEBYTECODE) wins."""
    if sys.pycache_prefix or sys.dont_write_bytecode:
        return
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    if os.path.isabs(base):
        sys.pycache_prefix = os.path.join(base, "claude-brain", "pyc")
    else:
        sys.dont_write_bytecode = True  # no home folder to cache in: write nothing rather than into the tree


if __name__ == "__main__":  # only for a real call: a caller that loads this file as a module keeps its own settings
    _bytecode_cache()

from engine import COMMANDS, MODULES  # noqa: E402


class _Help(argparse.HelpFormatter):
    """Help at one fixed width with a narrow left column: the reader is a
    model, not a terminal, and every wrapped line was 24 spaces of padding."""

    def __init__(self, prog):
        super().__init__(prog, max_help_position=18, width=120)


class Parser(argparse.ArgumentParser):
    """Usage errors in one line: what is wrong and which help to read. The
    usage block argparse prints first was the longest part of the answer and
    is the first thing that help shows anyway. Sub-commands inherit this."""

    def __init__(self, *args, **kwargs):
        kwargs.setdefault("formatter_class", _Help)
        super().__init__(*args, **kwargs)

    def error(self, message):
        self.exit(2, f"{self.prog}: {message} (see: {self.prog} --help)\n")


def build(only=None):
    """(parser, its sub-commands, the modules that failed to load). ``only``
    names the modules to load; the default is every module."""
    parser = Parser(prog="brain", description="Claude Brain engine")
    sub = parser.add_subparsers(dest="command", metavar="<command>")
    broken = []
    for name in only or MODULES:
        # One broken module must not take the whole command line down: `boot`
        # has to work even if, say, the scheduler fails to import.
        try:
            importlib.import_module(f"engine.{name}").register(sub)
        except Exception as e:
            broken.append(f"{name} ({type(e).__name__}: {str(e)[:60]})")
    return parser, sub, broken


def tree_for(argv):
    """The command tree one call needs: only the module that owns the command.
    Everything is loaded instead when the command is not in the table (help,
    a mistyped or new command), when its module does not load (so the cause
    can be named), and for `doctor`, which reports on every module."""
    owner = COMMANDS.get(argv[0]) if argv else None
    if owner and argv[0] != "doctor":
        tree = build([owner])
        if not tree[2] and argv[0] in tree[1].choices:
            return tree
    return build()


def _deepest(parser, argv):
    """The parser of the sub-command the words name, to say whose help to read."""
    for word in argv:
        subs = next((a for a in parser._actions if isinstance(a, argparse._SubParsersAction)), None)
        if subs is not None and word in subs.choices:
            parser = subs.choices[word]
    return parser


def _unknown_words(parser, argv, extra) -> None:
    """One line for words no command takes, with the closest real flag when
    there is one, so a mistyped flag does not cost a help look-up. Exits 2."""
    at = _deepest(parser, argv)
    flags = [o for a in at._actions for o in a.option_strings if o.startswith("--")]
    hint = ""
    for word in extra:
        if word.startswith("--"):
            import difflib
            near = difflib.get_close_matches(word.split("=")[0], flags, n=1, cutoff=0.6)
            if near:
                hint = f" (did you mean {near[0]}?)"
                break
    at.error(f"unrecognized arguments: {' '.join(extra)}{hint}")


def main(argv=None, tree=None) -> int:
    """Run one command. ``tree`` is a result of ``build()`` to reuse, for a
    caller that runs many commands in one process (the test suite)."""
    argv = list(sys.argv[1:] if argv is None else argv)
    parser, sub, broken = tree or tree_for(argv)
    wanted = argv[:1]
    if broken and wanted and not wanted[0].startswith("-") and wanted[0] not in sub.choices:
        # A command that is missing while a module failed to load is that
        # module's (or needs it): name the cause, not "invalid choice".
        print(f"'{wanted[0]}' is unavailable: failed to load " + "; ".join(broken) + ". Run `brain doctor`, fix that file, then run this again")
        return 1
    args, extra = parser.parse_known_args(argv)
    if extra:
        _unknown_words(parser, argv, extra)
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    if broken and args.command == "doctor":
        print("modules that failed to load: " + "; ".join(broken))
    try:
        return int(args.func(args) or 0)
    except BrokenPipeError:
        return 0
    except OSError as e:
        if type(e).__name__ != "StaleBrain":
            raise
        print(e)  # the project uses a newer contract than this brain: nothing was written there
        return 3


if __name__ == "__main__":
    sys.exit(main())
