#!/usr/bin/env python3
"""Claude Brain command line. Usage: brain <command> [options]. Standard library only."""
import argparse
import importlib
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
sys.dont_write_bytecode = True

from engine import MODULES  # noqa: E402


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="brain", description="Claude Brain engine")
    sub = parser.add_subparsers(dest="command")
    broken = []
    for name in MODULES:
        # One broken module must not take the whole command line down: `boot`
        # has to work even if, say, the scheduler fails to import.
        try:
            importlib.import_module(f"engine.{name}").register(sub)
        except Exception as e:
            broken.append(f"{name} ({type(e).__name__}: {str(e)[:60]})")
    wanted = (argv if argv is not None else sys.argv[1:])[:1]
    if broken and wanted and any(b.split(" ")[0] in wanted[0] or wanted[0] in ("plan", "close", "learn", "map") for b in broken) and wanted[0] not in sub.choices:
        print(f"the '{wanted[0]}' command is unavailable: " + "; ".join(broken))
        return 1
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 2
    if broken and args.command == "doctor":
        print("modules that failed to load: " + "; ".join(broken))
    try:
        return int(args.func(args) or 0)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
