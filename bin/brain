#!/usr/bin/env python3
"""Claude Brain command line. Usage: brain <command> [options]. Standard library only."""
import argparse
import importlib
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))
sys.dont_write_bytecode = True

MODULES = ["detect", "contract", "state", "req", "gate", "budget", "items", "recall", "route",
           "schedule", "repomap", "ledger", "learn", "guard", "doctor"]


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="brain", description="Claude Brain engine")
    sub = parser.add_subparsers(dest="command")
    missing = []
    for name in MODULES:
        try:
            mod = importlib.import_module(f"engine.{name}")
        except ModuleNotFoundError as e:
            if e.name == f"engine.{name}":
                missing.append(name)
                continue
            raise
        mod.register(sub)
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        if missing:
            print("modules not installed: " + ", ".join(missing))
        return 2
    try:
        return int(args.func(args) or 0)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
